{
  "name": "dsh-project-tabs",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH plugin: browser-style project tabs in the window title bar — one tab per session, running / finished / waiting-for-approval badges, drag to reorder, restored across restarts.",
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "plugin",
    "tabs",
    "workspace",
    "multi-project",
    "titlebar"
  ],
  "homepage": "https://github.com/miao-ge/dsh-project-tabs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miao-ge/dsh-project-tabs.git"
  },
  "bugs": {
    "url": "https://github.com/miao-ge/dsh-project-tabs/issues"
  },
  "author": "miao-ge",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
